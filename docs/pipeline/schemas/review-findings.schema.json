{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golden-ratio/pipeline/review-findings.schema.json",
  "title": "review-findings",
  "description": "Synthesized output of the capability-review stage for one applied OpenSpec change. Advisory: recorded, never blocks archive. Written to openspec/changes/<id>/review-findings.json and archived with the change.",
  "type": "object",
  "additionalProperties": false,
  "required": ["change", "generated_at", "maker", "gate_policy", "reviewers", "verdict_advisory", "counts"],
  "properties": {
    "change": { "type": "string", "description": "OpenSpec change id" },
    "generated_at": { "type": "string", "description": "ISO 8601 timestamp" },
    "base_sha": { "type": "string" },
    "head_sha": { "type": "string" },
    "maker": { "type": "string", "description": "Who implemented the change, e.g. 'opsx-apply (opus)'" },
    "gate_policy": { "type": "string", "enum": ["advisory", "blocking"], "default": "advisory" },
    "verdict_advisory": { "type": "string", "enum": ["clean", "concerns", "block"] },
    "notes": { "type": "string", "description": "Optional free-text synthesis / runtime-verification narrative for the change." },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "medium", "low"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 }
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer", "verdict", "findings"],
        "properties": {
          "reviewer": { "type": "string", "enum": ["code-reviewer", "spec-compliance-auditor", "security-reviewer", "code-review-cloud", "other"] },
          "model": { "type": "string" },
          "verdict": { "type": "string", "enum": ["clean", "concerns", "block"] },
          "strict_validation": { "type": "string", "description": "Optional `openspec validate --strict` outcome for the spec-compliance auditor, e.g. 'PASS'." },
          "summary": { "type": "string" },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "severity", "category", "summary", "status"],
              "properties": {
                "id": { "type": "string", "description": "e.g. CR-001, SEC-002, SPEC-003" },
                "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
                "category": { "type": "string", "enum": ["correctness", "quality", "reuse", "test", "spec", "security", "privacy", "a11y", "perf", "docs"] },
                "requirement_ids": { "type": "array", "items": { "type": "string" } },
                "file": { "type": "string" },
                "line": { "type": "integer" },
                "summary": { "type": "string" },
                "recommendation": { "type": "string" },
                "status": { "type": "string", "enum": ["open", "resolved", "wontfix"] },
                "corroborated_by": { "type": "array", "items": { "type": "string" }, "description": "other reviewers who independently raised this" }
              }
            }
          }
        }
      }
    }
  }
}
